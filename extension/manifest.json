{
  "manifest_version": 3,
  "name": "S&S Clearer for Amazon",
  "version": "1.1.0",
  "description": "Pick which Amazon Subscribe & Save subscriptions to cancel, then cancel them all in one go. Not affiliated with Amazon.",
  "permissions": ["storage"],
  "host_permissions": ["*://www.amazon.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "S&S Clearer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.amazon.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
